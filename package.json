{
  "name": "yolo-onnx-web",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.4",
  "description": "YOLO and SAM 3 browser inference powered by onnxruntime-web",
  "author": "ShiFang Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freefer/yolo-onnx-web.git"
  },
  "homepage": "https://freefer.github.io/yolo-onnx-web/",
  "bugs": {
    "url": "https://github.com/freefer/yolo-onnx-web/issues"
  },
  "keywords": [
    "yolov8",
    "yolov5",
    "yolov11",
    "rf-detr",
    "rt-detr",
    "yolo-nas",
    "yolo26",
    "sam3",
    "segment-anything",
    "webgpu",
    "onnx",
    "onnxruntime-web",
    "browser-inference"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:pages": "vite build --config vite.example.config.ts",
    "build:example": "npm run build:pages",
    "dev": "tsup --watch",
    "start": "vite --config vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "coi-serviceworker": "^0.1.7",
    "tsup": "latest",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  }
}
